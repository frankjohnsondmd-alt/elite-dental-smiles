{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/membership",
      "destination": "https://elite-dental-membership.vercel.app",
      "permanent": false
    },
    {
      "source": "/membership.html",
      "destination": "https://elite-dental-membership.vercel.app",
      "permanent": false
    },
    {
      "source": "/membership-signup",
      "destination": "https://elite-dental-membership.vercel.app/signup",
      "permanent": false
    },
    {
      "source": "/membership-signup.html",
      "destination": "https://elite-dental-membership.vercel.app/signup",
      "permanent": false
    },
    {
      "source": "/membership-portal",
      "destination": "https://elite-dental-membership.vercel.app/portal",
      "permanent": false
    },
    {
      "source": "/membership-portal.html",
      "destination": "https://elite-dental-membership.vercel.app/portal",
      "permanent": false
    },
    {
      "source": "/membership-admin",
      "destination": "https://elite-dental-membership.vercel.app/admin",
      "permanent": false
    },
    {
      "source": "/membership-admin.html",
      "destination": "https://elite-dental-membership.vercel.app/admin",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://formsubmit.co; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com; frame-src https://www.google.com https://maps.google.com; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
